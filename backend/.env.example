# ═══════════════════════════════════════════════════════════════════════
# Meridian FRC Attendance System – Environment Variables
# Copy this file to .env and fill in the values.
# ═══════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────
# Async PostgreSQL connection string (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://meridian:password@localhost:5432/meridian

# Redis connection string (used for rate limiting and caching).
REDIS_URL=redis://localhost:6379/0

# ── JWT / Authentication ──────────────────────────────────────────────
# Secret key used to sign JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME

# Algorithm used for JWT signing.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── pgcrypto Encryption ──────────────────────────────────────────────
# Symmetric key used by PostgreSQL pgcrypto for encrypting PII at rest.
PGP_SYM_KEY=CHANGE_ME

# ── Apple Wallet Pass Signing ────────────────────────────────────────
# Base64-encoded PEM certificate for signing Apple Wallet passes.
APPLE_PASS_CERT_B64=

# Base64-encoded PEM private key for the pass signing certificate.
APPLE_PASS_KEY_B64=

# Base64-encoded Apple WWDR intermediate certificate.
APPLE_PASS_WWDR_B64=

# Pass type identifier registered in your Apple Developer account (e.g. pass.com.team1234.meridian).
APPLE_PASS_TYPE_ID=

# Apple Developer Team ID.
APPLE_TEAM_ID=

# ── Google Wallet ────────────────────────────────────────────────────
# Base64-encoded Google Cloud service-account JSON with Wallet API permissions.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# ── APNs (Apple Push Notification service) ───────────────────────────
# Base64-encoded .p8 APNs auth key.
APNS_KEY_B64=

# Key ID from your Apple Developer account.
APNS_KEY_ID=

# Team ID for APNs (usually same as APPLE_TEAM_ID).
APNS_TEAM_ID=

# APNs topic – must match your pass type identifier.
APNS_TOPIC=

# ── FCM (Firebase Cloud Messaging) ──────────────────────────────────
# Firebase / Google Cloud project ID used for FCM push to Google Wallet.
FCM_PROJECT_ID=

# ── NFC ──────────────────────────────────────────────────────────────
# HMAC secret used to generate and verify NFC tag payloads.
NFC_HMAC_SECRET=CHANGE_ME

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Team Branding (optional) ─────────────────────────────────────────
# Displayed in the UI and on wallet passes.
TEAM_NAME=FRC Team
TEAM_NUMBER=
TEAM_LOGO_URL=

# ── Cron / Auto-timeout ─────────────────────────────────────────────
# Shared secret for authenticating the cron auto-timeout endpoint.
CRON_SECRET=CHANGE_ME

# ── Geofence ─────────────────────────────────────────────────────────
# JSON array of {lat, lng} objects defining the geofence polygon.
# Example: [{"lat":40.123,"lng":-74.456},{"lat":40.124,"lng":-74.457},{"lat":40.125,"lng":-74.455}]
GEOFENCE_POLYGON=

# Buffer in meters added around the geofence polygon.
GEOFENCE_BUFFER_METERS=150

# Grace period in seconds before a geofence exit triggers a checkout.
GEOFENCE_GRACE_PERIOD_SECONDS=90